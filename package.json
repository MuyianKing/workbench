{
  "name": "workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "前端开发工作台：管项目、记工作、看 AI 用量",
  "author": "muyian",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "preview:renderer": "vite --config vite.preview.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "dist": "tauri build",
    "dist:dir": "tauri build --no-bundle"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.8",
    "markdown-it": "^15.0.2",
    "pinia": "^4.0.3",
    "vditor": "^4.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
