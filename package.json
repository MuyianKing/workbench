{
  "name": "workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "前端开发工作台：管项目、记工作、看 AI 用量",
  "author": "muyian",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm -F @workbench/desktop dev",
    "build": "pnpm -F @workbench/desktop build",
    "dev:renderer": "pnpm -F @workbench/desktop dev:renderer",
    "build:renderer": "pnpm -F @workbench/desktop build:renderer",
    "preview:renderer": "pnpm -F @workbench/desktop preview:renderer",
    "typecheck": "pnpm run typecheck:code && pnpm run typecheck:test",
    "typecheck:code": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "icons": "pnpm -F @workbench/desktop icons",
    "vendor:pi": "pnpm -F @workbench/desktop vendor:pi",
    "bump": "node scripts/bump-version.mjs",
    "dist": "pnpm -F @workbench/desktop dist",
    "dist:dir": "pnpm -F @workbench/desktop dist:dir"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
