{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench",
  "version": "0.1.0",
  "identifier": "com.muyian.workbench",
  "build": {
    "frontendDist": "../out/renderer",
    "devUrl": "http://localhost:5274"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icon.ico"],
    "resources": {
      "../resources/backgrounds": "backgrounds"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
