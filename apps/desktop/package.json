{
  "name": "@workbench/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "前端开发工作台：管项目、记工作、看 AI 用量",
  "author": "muyian",
  "scripts": {
    "dev": "node scripts/vendor-pi.mjs && tauri dev",
    "build": "tauri build",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "preview:renderer": "vite --config vite.preview.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "vendor:pi": "node scripts/vendor-pi.mjs",
    "dist": "node scripts/vendor-pi.mjs && tauri build",
    "dist:dir": "node scripts/vendor-pi.mjs && tauri build --no-bundle"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.3.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@workbench/ai": "workspace:*",
    "@workbench/appearance": "workspace:*",
    "@workbench/auth": "workspace:*",
    "@workbench/core": "workspace:*",
    "@workbench/kb": "workspace:*",
    "@workbench/mail": "workspace:*",
    "@workbench/notes": "workspace:*",
    "@workbench/skills": "workspace:*",
    "@workbench/terminal": "workspace:*",
    "@workbench/usage": "workspace:*",
    "@workbench/vault": "workspace:*",
    "@workbench/video": "workspace:*",
    "@workbench/weather": "workspace:*",
    "@workbench/work-log": "workspace:*",
    "docx-preview": "^0.4.1",
    "element-plus": "^2.14.7",
    "pinia": "^4.0.3",
    "vditor": "^4.0.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
